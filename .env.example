# Public source configuration. The private migration repository already includes real credentials in .env.
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
DVAULT_IPFS_GATEWAY=
LOCALHOST_RPC_URL=http://127.0.0.1:8545
DVAULT_HTTP_PORT=4174
DVAULT_HTTPS_ORIGIN=
DVAULT_HTTPS_CERT=
DVAULT_HTTPS_KEY=
DVAULT_DEMO_TOKEN=
DVAULT_PERSONAL_FONT=bundled
DVAULT_VERIFY_ORIGIN=http://127.0.0.1:4174
DVAULT_NO_OPEN=0
# Optional one-time unlock for non-interactive agent startup; do not commit the actual code.
DVAULT_MIGRATION_PASSWORD=
